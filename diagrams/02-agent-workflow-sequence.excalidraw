   "versionNonce": 993260505,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Topology: hierarchical. Supervisor owns routing and budgets; workers never call each other directly, and only the Execution agent holds write-capable MCP tools (least privilege).",
   "originalText": "Topology: hierarchical. Supervisor owns routing and budgets; workers never call each other directly, and only the Execution agent holds write-capable MCP tools (least privilege).",
