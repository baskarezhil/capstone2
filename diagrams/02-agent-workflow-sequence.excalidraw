   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Protocols:  HTTPS webhook (ingest)  ·  in-process LangGraph edges (agent ↔ agent, hierarchical)  ·  MCP JSON-RPC over Streamable HTTP + OAuth (agent ↔ tools)  ·  W3C traceparent propagated on every hop (OTel)",
   "originalText": "Protocols:  HTTPS webhook (ingest)  ·  in-process LangGraph edges (agent ↔ agent, hierarchical)  ·  MCP JSON-RPC over Streamable HTTP + OAuth (agent ↔ tools)  ·  W3C traceparent propagated on every hop (OTel)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex86",
